parameters:
    level: max

    paths:
        - src
        - tests

    excludePaths:
        - tests/Application/*

    bootstrapFiles:
        - tests/Application/config/bootstrap.php

    # No symfony.consoleApplicationLoader or doctrine.objectManagerLoader: both would boot the test
    # application, which the static-code-analysis CI job can't do because it removes sylius/sylius first

    # Doctrine Configuration
    doctrine:
        repositoryClass: Doctrine\ORM\EntityRepository

    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
